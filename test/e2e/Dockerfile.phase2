FROM golang:1.27-alpine AS go-builder
RUN apk add --no-cache git
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /usr/local/bin/etcfuse-meta ./cmd/etcfuse-meta && \
    CGO_ENABLED=0 go build -o /usr/local/bin/seed-etcd   ./cmd/seed-etcd

FROM amazonlinux:2023 AS c-builder
RUN dnf install -y gcc make fuse3-devel fuse3-libs && dnf clean all
WORKDIR /build
COPY cmd/ cmd/
COPY pkg/  pkg/
RUN mkdir -p bin && \
    cc -Wall -Wextra -std=c11 -D_GNU_SOURCE -O2 -g -I. \
        cmd/etcfuse/main.c \
        pkg/fuse/fuse.c pkg/fuse/ops.c \
        pkg/block/block.c \
        -o bin/etcfuse -lfuse3 -lpthread

FROM amazonlinux:2023
RUN dnf install -y fuse3-libs findutils && dnf clean all
COPY --from=c-builder /build/bin/etcfuse         /usr/local/bin/etcfuse
COPY --from=go-builder /usr/local/bin/etcfuse-meta /usr/local/bin/etcfuse-meta
COPY --from=go-builder /usr/local/bin/seed-etcd   /usr/local/bin/seed-etcd
