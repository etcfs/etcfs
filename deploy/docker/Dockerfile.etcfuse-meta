# EtcFS metadata backend (Go component)
#
# Build:
#   docker build -f deploy/docker/Dockerfile.etcfuse-meta -t etcfuse-meta \
#     --build-arg VERSION=$(git describe --tags --always) .
#
# Multi-stage: compile in golang image, copy into minimal runtime.

# Must stay at or above go.mod's `go` directive: the image sets
# GOTOOLCHAIN=local, so a builder below it fails outright rather than fetching
# what the module asks for.
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=dev
RUN CGO_ENABLED=0 go build \
    -ldflags="-s -w -X github.com/etcfs/etcfs/internal/config.Version=${VERSION}" \
    -o /usr/local/bin/etcfuse-meta ./cmd/etcfuse-meta

FROM alpine:3.20

RUN apk add --no-cache ca-certificates

COPY --from=builder /usr/local/bin/etcfuse-meta /usr/local/bin/etcfuse-meta

ENTRYPOINT ["/usr/local/bin/etcfuse-meta"]
